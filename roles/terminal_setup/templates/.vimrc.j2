filetype plugin indent on
syntax on

set backspace=indent,eol,start

" Search settings
set incsearch        " Incremental search
set hlsearch         " Highlight search matches

" --- Persistent Undo ---
set undofile
set undodir=~/.vim/undo
if !isdirectory($HOME . "/.vim/undo")
  call mkdir($HOME . "/.vim/undo", "p")
endif

" Global indentation settings (filetype indent handles the smarts)
set expandtab
set shiftwidth=2
set softtabstop=2
set tabstop=2
set autoindent

augroup vimrc
  autocmd!
  " Python: PEP 8
  autocmd FileType python setlocal shiftwidth=4 softtabstop=4 tabstop=4 expandtab
  " YAML: 2 spaces
  autocmd FileType yaml setlocal shiftwidth=2 softtabstop=2 tabstop=2 expandtab
  " Highlight trailing whitespace in every window
  autocmd BufWinEnter * match ErrorMsg /\s\+$/
augroup END

" Toggle line numbers
nnoremap <silent> <F8> :set number!<CR>

" Normal mode outdent
nnoremap <S-Tab> <<

" Visual mode indent/unindent
vnoremap <Tab> >gv
vnoremap <S-Tab> <gv

" Insert mode outdent
inoremap <S-Tab> <C-d>

" Readable vimdiff colors (muted backgrounds, keep syntax highlighting)
hi DiffAdd    cterm=NONE ctermfg=NONE ctermbg=22
hi DiffDelete cterm=NONE ctermfg=131  ctermbg=52
hi DiffChange cterm=NONE ctermfg=NONE ctermbg=236
hi DiffText   cterm=bold ctermfg=NONE ctermbg=24

" All filetypes: p pastes the last yank (register 0), so later deletes don't change it
nnoremap <silent> p "0p

augroup yaml_copy_paste
  autocmd!
  " YAML: yank the selection and leave the cursor at its end, on its bottom line
  autocmd FileType yaml xnoremap <buffer> <silent> y y`]
  " YAML: put the last yank as whole lines below the current line, after one blank line
  autocmd FileType yaml nnoremap <buffer> <silent> p :<C-U>put =[''] + getreg('0', 1, 1)<CR>
augroup END
